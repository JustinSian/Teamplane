{
  "name": "teamplane",
  "version": "0.2.8",
  "description": "A deterministic control plane for multi-user agent teams: signed mandates, resource leases, permissioned memory and an auditable merge gate.",
  "keywords": [
    "agents",
    "multi-agent",
    "mcp",
    "deepseek-harness",
    "dsh",
    "authorization",
    "capability",
    "coordination"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JustinSian/teamplane.git"
  },
  "homepage": "https://github.com/JustinSian/teamplane#readme",
  "bugs": {
    "url": "https://github.com/JustinSian/teamplane/issues"
  },
  "type": "module",
  "bin": {
    "teamplane": "./bin/teamplane.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "web",
    "docs",
    "bench",
    "dsh-plugin",
    "README.md",
    "README.zh.md",
    "STATUS.md",
    "PRODUCT.md",
    "ROADMAP.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "demo": "npm run build && node bin/teamplane.js demo",
    "demo:ci": "npm run build && node bin/teamplane.js demo --ci",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "bench": "node bench/conflict-replay.mjs",
    "prepublishOnly": "npm run build",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "scan:secrets:history": "node scripts/scan-secrets.mjs --history"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@types/node": "^24.0.0",
    "typescript": "5.9.3"
  }
}
